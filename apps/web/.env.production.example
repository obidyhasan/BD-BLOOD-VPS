# Copy to apps/web/.env.production. NODE_ENV=production is set by the
# Dockerfile itself, so it isn't listed here.
#
# IMPORTANT: NEXT_PUBLIC_API_URL / NEXT_PUBLIC_SOCKET_URL / NEXT_PUBLIC_APP_URL
# are baked into the client bundle at BUILD time, not read at container
# start. Setting them here has no effect on an already-built image — they
# must be passed as docker-compose build args (see ../deploy/.env.example).
# They're repeated here only for local `next build` / `next start` outside
# Docker, and for reference/documentation.
NEXT_PUBLIC_API_URL=https://api.YOUR_DOMAIN.COM/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.YOUR_DOMAIN.COM
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN.COM

# Server-only Docker address; never expose this as NEXT_PUBLIC_*.
INTERNAL_API_URL=http://api:5000/api/v1

# Server-only, read at runtime (not baked at build time) — must match the
# backend's AUTH_COOKIE_DOMAIN exactly so the app and API share the login
# cookie across subdomains.
AUTH_COOKIE_DOMAIN=.YOUR_DOMAIN.COM

# Standalone API template. Docker Compose deployments use the root
# `.env.production.example`, which is the maintained production source.
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://bdblood:replace-me@postgres:5432/bdblood?schema=public

FRONTEND_URL=https://example.com,https://www.example.com
RESET_PASSWORD_URL=https://example.com/reset-password
VERIFY_EMAIL_URL=https://example.com/verify-email
AUTH_COOKIE_DOMAIN=.example.com
BCRYPT_SALT_NUMBER=12
ADMIN_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters

JWT_ACCESS_SECRET=replace-with-distinct-random-secret
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_SECRET=replace-with-distinct-random-secret
JWT_REFRESH_EXPIRES=90d
JWT_PASS_RESET_SECRET=replace-with-distinct-random-secret
JWT_PASS_RESET_EXPIRES=5m

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me

# Optional integrations: fill every value in a group or leave the group empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MIM_SMS_USERNAME=
MIM_SMS_API_KEY=
MIM_SMS_SENDER_NAME=
MIM_SMS_TRANSACTION_TYPE=T
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Used only by an explicit one-shot seed command; startup never auto-seeds.
ORGANIZATION_SEED_PHONE=+8801XXXXXXXXX
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_FULL_NAME=BD Blood Super Admin
ADMIN_BLOOD_GROUP=O+

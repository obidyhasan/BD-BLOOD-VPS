# Copy to apps/api/.env.production and fill in real secrets. Loaded by
# docker-compose's `env_file:` for the api service. Never commit the
# filled-in version — only this .example file belongs in git.

NODE_ENV=production
PORT=5000

# ---- Database ----
# `postgres` is the Docker Compose service name, resolvable only on the
# internal network — not a public hostname.
DATABASE_URL=postgresql://bdblood:change-me-strong-password@postgres:5432/bdblood?sslmode=disable

# ---- Frontend / CORS ----
# Comma-separated list of every origin the frontend is served from.
FRONTEND_URL=https://YOUR_DOMAIN.COM,https://www.YOUR_DOMAIN.COM
RESET_PASSWORD_URL=https://YOUR_DOMAIN.COM/reset-password
VERIFY_EMAIL_URL=https://YOUR_DOMAIN.COM/verify-email
# Shares the auth cookie across the apex, www, and api subdomains.
AUTH_COOKIE_DOMAIN=.YOUR_DOMAIN.COM

# ---- Security ----
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-long-random-value
BCRYPT_SALT_NUMBER=12

# ---- JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES=90d
JWT_PASS_RESET_SECRET=change-me
JWT_PASS_RESET_EXPIRES=5m

# ---- Cloudinary (required for image/file uploads) ----
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# ---- SMTP (required for password reset / verification emails) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Redis (optional — app degrades gracefully if unset, but caching/OTP
# perform noticeably better with it; `redis` is the Compose service name) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me-strong-password
REDIS_URL=

# ---- MiM SMS (Bangladesh) — required for donor/org SMS notifications ----
MIM_SMS_USERNAME=
MIM_SMS_API_KEY=
MIM_SMS_SENDER_NAME=
MIM_SMS_TRANSACTION_TYPE=T

# ---- OAuth (optional) ----
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CALLBACK_URL=https://api.YOUR_DOMAIN.COM/api/v1/auth/google/callback

# ---- Seeding ----
# Set to true only for the first deploy. This creates geography, blood groups,
# achievement definitions, and any missing canonical organization hierarchy.
# Use a real public coordination number; all generated organizations inherit it
# until Admin replaces organization-specific contact details.
RUN_SEEDS=true
ORGANIZATION_SEED_PHONE=+8801XXXXXXXXX
ADMIN_EMAIL=

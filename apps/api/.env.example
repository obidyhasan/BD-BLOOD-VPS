NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=verify-full
# Disposable PostgreSQL database used only by npm run test:db.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME_TEST?sslmode=verify-full

# Frontend
FRONTEND_URL=http://localhost:3000
# For multiple origins (comma-separated): https://bdbloodorg.vercel.app,https://www.bdblood.org,https://bdblood.org
RESET_PASSWORD_URL=http://localhost:3000/reset-password
VERIFY_EMAIL_URL=http://localhost:3000/verify-email
# Use .bdblood.org in production so bdblood.org, www.bdblood.org, and api.bdblood.org share one auth cookie scope.
AUTH_COOKIE_DOMAIN=.bdblood.org

# Security
ADMIN_BOOTSTRAP_SECRET=change-me
BCRYPT_SALT_NUMBER=12

# JWT
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES=90d
JWT_PASS_RESET_SECRET=change-me
JWT_PASS_RESET_EXPIRES=5m

# Cloudinary (optional)
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Redis (optional)
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# MiM SMS (Bangladesh) — https://www.mimsms.com/api-documentation
MIM_SMS_USERNAME=your_mimsms_login_email
MIM_SMS_API_KEY=your_mimsms_api_key
MIM_SMS_SENDER_NAME=your_approved_sender_id
MIM_SMS_TRANSACTION_TYPE=T

# OAuth (optional)
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Seeding: run npm run seed after migrations.
# Public coordination phone used only when creating missing canonical organizations.
ORGANIZATION_SEED_PHONE=+8801000000000

# Single Super Admin seed (required by npm run seed; never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_FULL_NAME=Platform Super Admin
ADMIN_BLOOD_GROUP=O+

{
  "name": "@bd-blood/api",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx src/app/seed/seed.ts"
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:unit": "tsx --test \"test/**/*.test.ts\"",
    "test:db": "tsx --test \"test/**/*.db.test.ts\"",
    "audit:migration": "tsx src/app/scripts/migrationAnomalyAudit.ts",
    "preflight:phase7": "tsx src/app/scripts/phase7CleanupPreflight.ts",
    "audit:reconciliation": "tsx src/app/scripts/systemReconciliationAudit.ts",
    "backfill:organizations": "tsx src/app/scripts/organizationAffiliationBackfill.ts",
    "backfill:organizations:apply": "tsx src/app/scripts/organizationAffiliationBackfill.ts --apply",
    "backfill:profiles": "tsx src/app/scripts/profileReadinessBackfill.ts",
    "backfill:profiles:apply": "tsx src/app/scripts/profileReadinessBackfill.ts --apply",
    "backfill:requests": "tsx src/app/scripts/requestLifecycleBackfill.ts",
    "backfill:requests:apply": "tsx src/app/scripts/requestLifecycleBackfill.ts --apply",
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "postinstall": "prisma generate",
    "build": "tsc && node -e \"require('fs').cpSync('src/app/views','dist/app/views',{recursive:true})\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "seed": "tsx src/app/seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/ejs": "^3.1.5",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary-v2": "^1.0.3",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "redis": "^5.6.1",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  }
}

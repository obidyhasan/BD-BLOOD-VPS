# Copy to `.env` at the repo root (same directory as docker-compose.yml)
# and fill in real values. This file is consumed by docker-compose itself
# (Postgres/Redis container credentials, and the frontend's build-time
# NEXT_PUBLIC_* args) — it is NOT the same as apps/api/.env.production or
# apps/web/.env.production, which configure the applications themselves.

# ---- Postgres (container credentials) ----
POSTGRES_USER=bdblood
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bdblood

# ---- Redis (container credentials) ----
REDIS_PASSWORD=change-me-strong-password

# ---- Frontend build args (baked into the client bundle at build time) ----
# Must point at the public, internet-facing URLs — NOT the internal Docker
# service names — because these are fetched from the user's browser.
NEXT_PUBLIC_API_URL=https://api.YOUR_DOMAIN.COM/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.YOUR_DOMAIN.COM
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN.COM

# Copy to .env.production and use it with:
# docker compose --env-file .env.production <command>
# Never commit the populated file. Generate secrets with: openssl rand -hex 32

# Application / release
COMPOSE_PROJECT_NAME=bdblood
IMAGE_TAG=latest
APP_DOMAIN=example.com
API_DOMAIN=api.example.com
CERTBOT_EMAIL=admin@example.com
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# PostgreSQL. Keep the credentials in DATABASE_URL identical to the three
# POSTGRES_* values. Use URL-safe hex for the password to avoid URI escaping.
POSTGRES_USER=bdblood
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_DB=bdblood
DATABASE_URL=postgresql://bdblood:replace-with-the-same-postgres-password@postgres:5432/bdblood?schema=public&connection_limit=10&pool_timeout=20

# Redis (private Docker network only)
REDIS_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_MAXMEMORY=192mb

# Browser origins / auth cookie scope
FRONTEND_URL=https://example.com,https://www.example.com
RESET_PASSWORD_URL=https://example.com/reset-password
VERIFY_EMAIL_URL=https://example.com/verify-email
AUTH_COOKIE_DOMAIN=.example.com
BCRYPT_SALT_NUMBER=12
ADMIN_BOOTSTRAP_SECRET=replace-with-a-distinct-openssl-rand-hex-32-value

# JWT: generate three different values
JWT_ACCESS_SECRET=replace-with-a-distinct-openssl-rand-hex-32-value
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_SECRET=replace-with-a-distinct-openssl-rand-hex-32-value
JWT_REFRESH_EXPIRES=90d
JWT_PASS_RESET_SECRET=replace-with-a-distinct-openssl-rand-hex-32-value
JWT_PASS_RESET_EXPIRES=5m

# Cloudinary (all three or all empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (all five or all empty)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# MiM SMS (all three or all empty)
MIM_SMS_USERNAME=
MIM_SMS_API_KEY=
MIM_SMS_SENDER_NAME=
MIM_SMS_TRANSACTION_TYPE=T

# Google OAuth (all three or all empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Used only by the explicit one-shot production seed command
ORGANIZATION_SEED_PHONE=+8801XXXXXXXXX
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_FULL_NAME=BD Blood Super Admin
ADMIN_BLOOD_GROUP=O+

# Optional memory ceilings for a 4 GB VPS
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
API_MEMORY_LIMIT=768m
WORKER_MEMORY_LIMIT=512m
WEB_MEMORY_LIMIT=768m
NGINX_MEMORY_LIMIT=256m
MIGRATION_MEMORY_LIMIT=512m
SEED_MEMORY_LIMIT=768m
